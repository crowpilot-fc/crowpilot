// Declarative parameter table. This file is an X-macro fragment: it has no
// include guard and is #included multiple times, once per use site, each
// time with a different definition of CP_PARAM. See Params.h (enum
// generation) and Params.cpp (registry initialisation, persistence).
//
// CP_PARAM(id, key, default_expr, min, max, persist)
//   id           - enumerator name in cp::params::ParamId
//   key          - stable string key used in the persisted file and lookup
//   default_expr - default value, normally the matching Config.h constant
//   min, max     - inclusive clamp bounds applied by cp::params::set()
//   persist      - 1 to write this parameter to flash, 0 for volatile only
//
// v1.0 registers the PID gain set. The table is the single place to extend
// the parameter system: add a CP_PARAM line and the enum, registry, and
// persistence pick it up with no other change.

CP_PARAM(KP_ROLL_HOVER,  "kp_roll_hover",  Kp_roll_hover,  0.0f, 4.0f, 1)
CP_PARAM(KD_ROLL_HOVER,  "kd_roll_hover",  Kd_roll_hover,  0.0f, 1.0f, 1)
CP_PARAM(KP_PITCH_HOVER, "kp_pitch_hover", Kp_pitch_hover, 0.0f, 4.0f, 1)
CP_PARAM(KD_PITCH_HOVER, "kd_pitch_hover", Kd_pitch_hover, 0.0f, 1.0f, 1)
CP_PARAM(KP_YAW_HOVER,   "kp_yaw_hover",   Kp_yaw_hover,   0.0f, 4.0f, 1)
CP_PARAM(KD_YAW_HOVER,   "kd_yaw_hover",   Kd_yaw_hover,   0.0f, 1.0f, 1)

CP_PARAM(KP_ROLL_FF,     "kp_roll_ff",     Kp_roll_ff,     0.0f, 4.0f, 1)
CP_PARAM(KD_ROLL_FF,     "kd_roll_ff",     Kd_roll_ff,     0.0f, 1.0f, 1)
CP_PARAM(KP_PITCH_FF,    "kp_pitch_ff",    Kp_pitch_ff,    0.0f, 4.0f, 1)
CP_PARAM(KD_PITCH_FF,    "kd_pitch_ff",    Kd_pitch_ff,    0.0f, 1.0f, 1)
CP_PARAM(KP_YAW_FF,      "kp_yaw_ff",      Kp_yaw_ff,      0.0f, 4.0f, 1)
CP_PARAM(KD_YAW_FF,      "kd_yaw_ff",      Kd_yaw_ff,      0.0f, 1.0f, 1)

CP_PARAM(KI_ROLL,        "ki_roll",        Ki_roll,        0.0f, 1.0f, 1)
CP_PARAM(KI_PITCH,       "ki_pitch",       Ki_pitch,       0.0f, 1.0f, 1)
CP_PARAM(KI_YAW,         "ki_yaw",         Ki_yaw,         0.0f, 1.0f, 1)

// Plane stabilizer gains. Registered so the configurator sliders and the
// transmitter live-tune knobs adjust them at runtime, the same way they do the
// tailsitter PID above. The enumerator names differ from the Config.h
// constexpr defaults (which supply the initial values) to avoid a name clash.
CP_PARAM(KP_ROLL_PLANE,  "kp_stab_roll",   KP_STAB_ROLL,        0.0f, 4.0f, 1)
CP_PARAM(KD_ROLL_PLANE,  "kd_stab_roll",   KD_STAB_ROLL,        0.0f, 1.0f, 1)
CP_PARAM(KP_PITCH_PLANE, "kp_stab_pitch",  KP_STAB_PITCH,       0.0f, 4.0f, 1)
CP_PARAM(KD_PITCH_PLANE, "kd_stab_pitch",  KD_STAB_PITCH,       0.0f, 1.0f, 1)
CP_PARAM(KD_YAW_PLANE,   "kd_stab_yaw",    KD_STAB_YAW,         0.0f, 1.0f, 1)
CP_PARAM(KP_RATE_ROLL_PLANE,  "kp_rate_roll",  KP_PLANE_RATE_ROLL,  0.0f, 0.05f, 1)
CP_PARAM(KP_RATE_PITCH_PLANE, "kp_rate_pitch", KP_PLANE_RATE_PITCH, 0.0f, 0.05f, 1)

// Stab authority. GAIN_CHANNEL picks which transmitter channel carries the
// authority knob (0 = none, 1..16 = channel index). GAIN_AUTHORITY is the
// fallback authority used when no channel is assigned or before the first
// receiver frame arrives. GAIN_LPF_TC_S is the time constant of the
// first-order low-pass on the channel reading.
CP_PARAM(GAIN_CHANNEL,    "gain_channel",   GAIN_CHANNEL_DEFAULT,   0.0f, 16.0f, 1)
CP_PARAM(GAIN_AUTHORITY,  "gain_authority", GAIN_AUTHORITY_DEFAULT, 0.0f,  1.0f, 1)
CP_PARAM(GAIN_LPF_TC_S,   "gain_lpf_tc_s",  GAIN_LPF_TC_DEFAULT_S,  0.01f, 5.0f, 1)

// Plane shape primitives, read by AIRFRAME_PLANE_GENERIC. One PCB design plus
// one firmware flash supports every plane variant; the pilot picks the shape
// via the Crowpilot Companion app and the generic mixer composes the right
// mix. PLANE_TAIL_STYLE values: 0 traditional, 1 V-tail, 2 none (flying wing).
CP_PARAM(PLANE_MOTORS_COUNT,  "plane_motors",  PLANE_MOTORS_COUNT_DEFAULT,  1.0f, 2.0f, 1)
CP_PARAM(PLANE_TAIL_STYLE,    "plane_tail",    PLANE_TAIL_STYLE_DEFAULT,    0.0f, 2.0f, 1)
CP_PARAM(PLANE_AILERON_COUNT, "plane_ailerons", PLANE_AILERON_COUNT_DEFAULT, 0.0f, 2.0f, 1)

// Failsafe channel values applied when the receiver link is lost. Compile-time
// defaults come from the per-airframe constexpr block (FS_THROTTLE_US, etc.)
// so an out-of-the-box build behaves the same as v0.x. The pilot can override
// any of these via the Crowpilot Companion app to suit a specific airframe
// (e.g. a heavy plane might prefer 1100us for slight residual thrust on
// glide, while a flying wing wants pure 1000us motors-off).
CP_PARAM(FS_THROTTLE_US_RT, "fs_throttle_us", FS_THROTTLE_US, 1000.0f, 2000.0f, 1)
CP_PARAM(FS_ROLL_US_RT,     "fs_roll_us",     FS_ROLL_US,     1000.0f, 2000.0f, 1)
CP_PARAM(FS_PITCH_US_RT,    "fs_pitch_us",    FS_PITCH_US,    1000.0f, 2000.0f, 1)
CP_PARAM(FS_YAW_US_RT,      "fs_yaw_us",      FS_YAW_US,      1000.0f, 2000.0f, 1)
CP_PARAM(FS_ARM_US_RT,      "fs_arm_us",      FS_ARM_US,      1000.0f, 2000.0f, 1)

// Runtime RX protocol selection. Default matches the compile-time RX_PROTOCOL
// so existing builds keep working. Changing this param via the Crowpilot
// Companion app saves the new value to flash but DOES NOT YET re-init the
// receiver; the runtime RX dispatch refactor is scheduled for a focused
// follow-up session because all three protocol drivers (SBUS PIO, PWM
// interrupts, CRSF UART) need to compile in alongside each other. For now
// this param is data only; reading and writing it works but the firmware
// reads the compile-time RX_PROTOCOL macro to actually configure the
// receiver. After the refactor, this param becomes the source of truth and
// changes trigger a reboot to apply.
CP_PARAM(RX_PROTOCOL_RT, "rx_protocol", RX_PROTOCOL, 0.0f, 3.0f, 1)
